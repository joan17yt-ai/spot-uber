<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dockContainer"
    android:layout_width="145dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay_hud"
    android:elevation="16dp"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- STATUS BADGE -->
    <TextView
        android:id="@+id/tvStatusBadge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1e293b"
        android:gravity="center"
        android:paddingVertical="3dp"
        android:text="⚪ EN ESPERA"
        android:textColor="#94a3b8"
        android:textSize="10sp"
        android:textStyle="bold" />

    <!-- ROW 1: TOTAL KM & TOTAL MIN (ROUTE SUMMARY) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="#131d31"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="3dp">

        <TextView
            android:id="@+id/tvTotalKm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0.0 km"
            android:textColor="#38bdf8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="•"
            android:textColor="#475569"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvTotalMin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0 min"
            android:textColor="#cbd5e1"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="3dp"
        android:background="#1e293b" />

    <!-- ROW 2: ORIGIN / PICKUP -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📍 Recogida"
            android:textColor="#64748b"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvOriginDist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.0 km"
            android:textColor="#94a3b8"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ROW 3: RATE PER KM -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💵 $/Km"
            android:textColor="#64748b"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvPerKm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$0"
            android:textColor="#38bdf8"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ROW 4: RATE PER MINUTE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⏱️ $/Min"
            android:textColor="#64748b"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvPerMin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$0"
            android:textColor="#f8fafc"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ROW 5: FAIR PRICE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💡 Justa"
            android:textColor="#64748b"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tvFairPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$0"
            android:textColor="#fef08a"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="3dp"
        android:background="#1e293b" />

    <!-- ROW 6: BALANCE / FALTANTE / SOBRANTE -->
    <TextView
        android:id="@+id/tvDiffPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="BALANCE: --"
        android:textColor="#64748b"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
