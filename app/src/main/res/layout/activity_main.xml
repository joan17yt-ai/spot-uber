<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UBERSPOT PRO"
                    android:textColor="#00d2ff"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dock Lateral Uber"
                    android:textColor="#ffffff"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Bucaramanga, Colombia"
                    android:textColor="#94a3b8"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_dark"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="DOCK EDITION"
                android:textColor="#38bdf8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- MASTER SWITCH CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_master"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ESTADO DEL ASISTENTE"
                android:textColor="#00d2ff"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <Switch
                android:id="@+id/swServiceActive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="🟢 Asistente ACTIVO (En Turno)"
                android:textColor="#10b981"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSwitchSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Ventana lateral fija activa en pantalla (0ms de delay)"
                android:textColor="#94a3b8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- FINANCIAL STRATEGY & PICKUP FILTERS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_sleek"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🎯 TUS PARÁMETROS DE RENTABILIDAD"
                    android:textColor="#38bdf8"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#064e3b"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="Opción B Activa"
                    android:textColor="#34d399"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Evalúa distancia, tiempo y cercanía del origen:"
                android:textColor="#64748b"
                android:textSize="11sp" />

            <!-- FILTER 1: MAX PICKUP DISTANCE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="📍 Distancia Máxima a Origen / Recogida (Km):"
                android:textColor="#f8fafc"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Si la recogida supera este límite, la app marcará RECHAZAR"
                android:textColor="#64748b"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/etMaxPickup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:text="2.5"
                android:textColor="#38bdf8"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- FILTER 2: MIN RATE KM -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Tarifa Mínima por Kilómetro (COP):"
                android:textColor="#cbd5e1"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etMinKm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:inputType="number"
                android:padding="12dp"
                android:text="1800"
                android:textColor="#ffffff"
                android:textSize="15sp" />

            <!-- FILTER 3: MIN RATE MINUTE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Tarifa Mínima por Minuto (ej: 400 = $24.000/h):"
                android:textColor="#cbd5e1"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etMinTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:inputType="number"
                android:padding="12dp"
                android:text="400"
                android:textColor="#ffffff"
                android:textSize="15sp" />

            <!-- SAVE BUTTON -->
            <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_cyan"
                android:text="💾 Guardar Configuración"
                android:textColor="#070b14"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- SYSTEM PERMISSIONS CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_sleek"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 PERMISOS Y BLINDAJE EN SEGUNDO PLANO"
                android:textColor="#f59e0b"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Asegura que el dock lateral se dibuje y no se cierre en segundo plano:"
                android:textColor="#64748b"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnPermAccess"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_dark"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="14dp"
                android:text="1. Activar Servicio de Accesibilidad (OBLIGATORIO)"
                android:textColor="#00d2ff"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnBatteryOptimize"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_dark"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="14dp"
                android:text="2. Batería en 'Sin Restricciones' (Evita cierres en Xiaomi)"
                android:textColor="#10b981"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPermOverlay"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_dark"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="14dp"
                android:text="3. Permitir Ventana Flotante (Aparecer encima)"
                android:textColor="#cbd5e1"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- LIVE DEMO / SIMULATOR CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_sleek"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧪 PRUEBA EN VIVO"
                android:textColor="#10b981"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Simula una oferta en la ventana lateral (vuelve a 0 en 10s):"
                android:textColor="#64748b"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnTestUber"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_dark"
                android:text="🚗 Simular Oferta en Dock Lateral"
                android:textColor="#10b981"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="24dp"
            android:gravity="center"
            android:text="UberSpot Pro • Dock Lateral • Bucaramanga"
            android:textColor="#475569"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
